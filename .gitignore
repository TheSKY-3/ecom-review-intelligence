# Raw data and locally generated data products
data/raw/
data/interim/
data/processed/
artifacts/indexes/
artifacts/evals/

# Pytest --basetemp leftovers: these hold copies of the raw gzip files and
# full review stores under nested data/ paths that the anchored data/ rules
# above do not reach. 37 such directories existed locally; never commit them.
.task*/
test-tmp-task8/

# Local agent workspace state
/.workbuddy/

# Local runtime state
.env
.venv/
__pycache__/
.pytest_cache/
.ruff_cache/
*.py[cod]
*.egg-info/
.tools/
# Scratch workspace: holds raw review text (labeling batches, exports, dumps).
/tmp/
output/desktop/
dist/
build/

# Local editor and operating-system files
.vscode/
.idea/
.DS_Store
Thumbs.db

# Node tooling for the browser validation script
node_modules/

# Local scratch and generated exports
build_tmp/
build_tmp2/
output/obsidian/

# The published demo subset ships with the project; its runtime state does not.
!data/public/
data/public/*
!data/public/ice_makers_public.sqlite
data/public/state/
